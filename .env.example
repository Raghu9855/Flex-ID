# Environment Configuration for FLEX-ID Backend
PROJECT_NAME="FLEX-ID — Federated Intrusion Detection Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration
# Default local SQLite:
DATABASE_URL="sqlite:///./flex_id.db"
# Production MySQL Example:
# DATABASE_URL="mysql+pymysql://flex_user:flex_password@localhost:3306/flex_id_db"

# Server Settings
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Model & Artifact Directories
DATA_DIR="data"
RESULTS_DIR="results"
DEFAULT_MODEL_VERSION="fedprox-v1"
DEFAULT_STRATEGY="fedprox"

# Security & Limits
MAX_BATCH_SIZE=1000
INFERENCE_TIMEOUT_SECONDS=10.0
