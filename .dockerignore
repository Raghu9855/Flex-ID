# ==============================================================================
# Docker Build Ignore Configuration for FLEX-ID
# ==============================================================================
# Node & Frontend legacy files
node_modules
frontend/node_modules
backend/node_modules
frontend/dist

# Version control & IDE
.git
.gitignore
.gitattributes
.vscode
.idea

# Python virtual environments & bytecode
venv/
ml-env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
tests/
flex_id.db

# Exclude massive raw/processed training data (>490 MB)
# The serving runtime strictly needs data/scaler.pkl and data/label_encoder.pkl
data/*.csv
data/client_partition_*.pkl

# Exclude generated visual plots from container layer to optimize size
results/*.png
