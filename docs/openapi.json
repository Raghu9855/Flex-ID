{
  "openapi": "3.1.0",
  "info": {
    "title": "FLEX-ID \u2014 Federated Intrusion Detection Platform",
    "description": "Production-oriented backend and inference API for **FLEX-ID** (Federated Learning Explainable Intrusion Detection System). Provides validated multi-class traffic classification, batch inference, federated experiment tracking, and explainable AI analytics.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health & Status"
        ],
        "summary": "Check Health",
        "description": "Evaluates backend health, database connectivity, and ML model serving readiness.",
        "operationId": "check_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health & Status"
        ],
        "summary": "Application Health Probe",
        "description": "Evaluates backend health, database connectivity, and ML model serving readiness.",
        "operationId": "check_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": [
          "Models & Serving"
        ],
        "summary": "List Registered Models",
        "description": "Returns all registered federated model checkpoints, including metrics and active status.",
        "operationId": "list_models_api_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/{model_id_or_version}": {
      "get": {
        "tags": [
          "Models & Serving"
        ],
        "summary": "Get Model Details",
        "description": "Retrieves metadata, metrics, and weights path for a specific model ID or version name.",
        "operationId": "get_model_details_api_v1_models__model_id_or_version__get",
        "parameters": [
          {
            "name": "model_id_or_version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Id Or Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetadataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/{model_version}/activate": {
      "post": {
        "tags": [
          "Models & Serving"
        ],
        "summary": "Activate Model for Inference",
        "description": "Sets the designated model version as the default active model for live traffic inference.",
        "operationId": "activate_model_api_v1_models__model_version__activate_post",
        "parameters": [
          {
            "name": "model_version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Version"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelMetadataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions": {
      "post": {
        "tags": [
          "Intrusion Detection"
        ],
        "summary": "Predict Network Traffic Intrusion",
        "description": "Accepts 29 network traffic flow metrics and evaluates whether the packet stream\nrepresents Benign traffic or an active Intrusion (DoS, BruteForce, Botnet, Web Attack).",
        "operationId": "predict_traffic_api_v1_predictions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrafficFeaturesInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions/batch": {
      "post": {
        "tags": [
          "Intrusion Detection"
        ],
        "summary": "Batch Predict Network Traffic",
        "description": "Processes an array of network flow records concurrently with bounded latency and resource usage.",
        "operationId": "predict_traffic_batch_api_v1_predictions_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchTrafficInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchPredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/predictions/{prediction_id}": {
      "get": {
        "tags": [
          "Intrusion Detection"
        ],
        "summary": "Retrieve Audited Prediction Log",
        "description": "Retrieves stored audit log and prediction outcome by prediction ID.",
        "operationId": "get_prediction_log_api_v1_predictions__prediction_id__get",
        "parameters": [
          {
            "name": "prediction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Prediction Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments": {
      "get": {
        "tags": [
          "Federated Learning"
        ],
        "summary": "List Federated Experiments",
        "description": "Retrieves all past and currently executing federated training experiments.",
        "operationId": "list_experiments_api_v1_experiments_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Federated Learning"
        ],
        "summary": "Trigger Federated Experiment",
        "description": "Initiates a new federated learning training run with specified aggregation strategy,\nnumber of rounds, client partitioning, and adversarial attack configuration.",
        "operationId": "create_experiment_api_v1_experiments_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExperimentCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments/{experiment_id}": {
      "get": {
        "tags": [
          "Federated Learning"
        ],
        "summary": "Get Experiment Details",
        "description": "Retrieves execution parameters, current status, and summary metrics for an experiment.",
        "operationId": "get_experiment_details_api_v1_experiments__experiment_id__get",
        "parameters": [
          {
            "name": "experiment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExperimentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/experiments/{experiment_id}/metrics": {
      "get": {
        "tags": [
          "Federated Learning"
        ],
        "summary": "Get Round-Level Metrics",
        "description": "Returns the progression of training loss, evaluation accuracy, and F1-score across all rounds.",
        "operationId": "get_experiment_metrics_api_v1_experiments__experiment_id__metrics_get",
        "parameters": [
          {
            "name": "experiment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Experiment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MetricRecord"
                  },
                  "title": "Response Get Experiment Metrics Api V1 Experiments  Experiment Id  Metrics Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/explanations": {
      "post": {
        "tags": [
          "Explainable AI (XAI)"
        ],
        "summary": "Explain Network Traffic Prediction",
        "description": "Computes local feature attribution and retrieves federated SHAP global importance\nto explain why a particular network packet flow was classified as benign or malicious.",
        "operationId": "explain_prediction_api_v1_explanations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplanationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplanationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BatchPredictionResponse": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "total_processed": {
            "type": "integer",
            "title": "Total Processed"
          },
          "intrusions_detected": {
            "type": "integer",
            "title": "Intrusions Detected"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/PredictionResponse"
            },
            "type": "array",
            "title": "Predictions"
          },
          "total_latency_ms": {
            "type": "number",
            "title": "Total Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "model_version",
          "total_processed",
          "intrusions_detected",
          "predictions",
          "total_latency_ms"
        ],
        "title": "BatchPredictionResponse"
      },
      "BatchTrafficInput": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/TrafficFeaturesInput"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Records"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          }
        },
        "type": "object",
        "required": [
          "records"
        ],
        "title": "BatchTrafficInput"
      },
      "ExperimentCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 3,
            "title": "Name",
            "description": "Experiment name"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy",
            "description": "Aggregation strategy: fedavg, fedprox, krum, multikrum, trimmed_mean, median",
            "default": "fedprox"
          },
          "rounds": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Rounds",
            "description": "Total training rounds",
            "default": 10
          },
          "num_clients": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 2.0,
            "title": "Num Clients",
            "description": "Number of logical federated clients",
            "default": 4
          },
          "proximal_mu": {
            "type": "number",
            "minimum": 0.0,
            "title": "Proximal Mu",
            "description": "FedProx proximal regularizer mu",
            "default": 0.1
          },
          "is_attack": {
            "type": "boolean",
            "title": "Is Attack",
            "description": "Whether to include adversarial clients",
            "default": false
          },
          "attack_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attack Type",
            "description": "Attack type if is_attack=True: flip, noise, backdoor, byzantine, adaptive"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "ExperimentCreate"
      },
      "ExperimentListResponse": {
        "properties": {
          "total_experiments": {
            "type": "integer",
            "title": "Total Experiments"
          },
          "experiments": {
            "items": {
              "$ref": "#/components/schemas/ExperimentResponse"
            },
            "type": "array",
            "title": "Experiments"
          }
        },
        "type": "object",
        "required": [
          "total_experiments",
          "experiments"
        ],
        "title": "ExperimentListResponse"
      },
      "ExperimentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "strategy": {
            "type": "string",
            "title": "Strategy"
          },
          "rounds": {
            "type": "integer",
            "title": "Rounds"
          },
          "num_clients": {
            "type": "integer",
            "title": "Num Clients"
          },
          "proximal_mu": {
            "type": "number",
            "title": "Proximal Mu"
          },
          "is_attack": {
            "type": "boolean",
            "title": "Is Attack"
          },
          "attack_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Attack Type"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "metrics": {
            "items": {
              "$ref": "#/components/schemas/MetricRecord"
            },
            "type": "array",
            "title": "Metrics"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "strategy",
          "rounds",
          "num_clients",
          "proximal_mu",
          "is_attack",
          "status",
          "created_at"
        ],
        "title": "ExperimentResponse"
      },
      "ExplanationRequest": {
        "properties": {
          "features": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              }
            ],
            "title": "Features",
            "description": "Traffic flow feature values"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version",
            "description": "Model version to explain"
          },
          "top_k": {
            "type": "integer",
            "maximum": 29.0,
            "minimum": 1.0,
            "title": "Top K",
            "description": "Number of top features to return",
            "default": 5
          }
        },
        "type": "object",
        "required": [
          "features"
        ],
        "title": "ExplanationRequest"
      },
      "ExplanationResponse": {
        "properties": {
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "predicted_class": {
            "type": "string",
            "title": "Predicted Class"
          },
          "is_intrusion": {
            "type": "boolean",
            "title": "Is Intrusion"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "Federated-SHAP / Fast Feature Attribution"
          },
          "top_contributing_features": {
            "items": {
              "$ref": "#/components/schemas/FeatureContribution"
            },
            "type": "array",
            "title": "Top Contributing Features"
          },
          "global_importance_baseline": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Global Importance Baseline"
          },
          "summary": {
            "type": "string",
            "title": "Summary",
            "description": "Human-readable explanation for security analysts"
          }
        },
        "type": "object",
        "required": [
          "model_version",
          "predicted_class",
          "is_intrusion",
          "confidence",
          "top_contributing_features",
          "summary"
        ],
        "title": "ExplanationResponse"
      },
      "FeatureContribution": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature",
            "description": "Feature name"
          },
          "importance": {
            "type": "number",
            "title": "Importance",
            "description": "Absolute or directional attribution magnitude"
          },
          "direction": {
            "type": "string",
            "title": "Direction",
            "description": "'positive' (increases attack probability) or 'negative' (favors benign)"
          }
        },
        "type": "object",
        "required": [
          "feature",
          "importance",
          "direction"
        ],
        "title": "FeatureContribution"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Overall system health status",
            "default": "healthy"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "description": "Running environment (development/production)"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "description": "API version"
          },
          "database_connected": {
            "type": "boolean",
            "title": "Database Connected",
            "description": "Database connectivity status"
          },
          "active_model": {
            "type": "string",
            "title": "Active Model",
            "description": "Active default model version"
          },
          "components": {
            "additionalProperties": true,
            "type": "object",
            "title": "Components",
            "description": "Detailed component statuses"
          }
        },
        "type": "object",
        "required": [
          "environment",
          "version",
          "database_connected",
          "active_model"
        ],
        "title": "HealthResponse"
      },
      "MetricRecord": {
        "properties": {
          "round_number": {
            "type": "integer",
            "title": "Round Number"
          },
          "train_loss": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Train Loss"
          },
          "accuracy": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy"
          },
          "f1_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "F1 Score"
          }
        },
        "type": "object",
        "required": [
          "round_number"
        ],
        "title": "MetricRecord"
      },
      "ModelListResponse": {
        "properties": {
          "total_models": {
            "type": "integer",
            "title": "Total Models"
          },
          "active_model": {
            "type": "string",
            "title": "Active Model"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelMetadataResponse"
            },
            "type": "array",
            "title": "Models"
          }
        },
        "type": "object",
